<section id="hobbies" class="hobbies">
  <h2 class="hobbies__title">Hobbies</h2>
  <ul role="list" class="hobbies__list">
    <li class="hobbies__item">
      <figure class="hobbies__figure">
        {{> image name="hobby" title="Programar" image="images/icon-programar.svg"}}
      </figure>
      <p class="hobbies__name">Programar</p>
    </li>
    <li class="hobbies__item">
      <figure class="hobbies__figure">
        {{> image name="hobby" title="Diseñar" image="images/icon-diseñar.svg"}}
      </figure>
      <p class="hobbies__name">Diseñar</p>
    </li>
    <li class="hobbies__item">
      <figure class="hobbies__figure">
        {{> image name="hobby" title="Viajar" image="images/icon-viajar.svg"}}
      </figure>
      <p class="hobbies__name">Viajar</p>
    </li>
    <li class="hobbies__item">
      <figure class="hobbies__figure">
        {{> image name="hobby" title="Leer" image="images/icon-leer.svg"}}
      </figure>
      <p class="hobbies__name">Leer</p>
    </li>
  </ul>
</section>
